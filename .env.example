# Connection details for the RDS SQL Server instance standing in for the
# customer's system of record. In production these are encrypted Vercel
# environment variables, and the instance is not publicly reachable: its
# security group allows inbound 1433 only from this project's Secure Compute
# static outbound IPs.
# DB_HOST is the RDS *endpoint* hostname, not the DB instance identifier.
# Find it on the instance's "Connectivity & security" tab. It looks like
# <identifier>.<random>.<region>.rds.amazonaws.com
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=

# The database created *inside* the instance by `npm run db:migrate`. This is
# not the DB instance identifier, and it is not the master username. RDS for
# SQL Server provides no way to create a database at instance-creation time,
# which is why the migrate script has to do it.
DB_NAME=cdd

# Per-instance connection pool size. Kept low on purpose: SQL Server Express
# is capped at one socket and 1GB of RAM, and many serverless instances can be
# warm at once. See the comment in lib/db.ts.
DB_POOL_SIZE=3

# Amazon RDS CA bundle, as PEM text.
#
# REQUIRED. Unlike mysql2, the tedious driver behind mssql ships no RDS CA
# bundle, and Node's default trust store does not contain the Amazon RDS root
# CAs. Without this the only way to connect is trustServerCertificate: true,
# which accepts any certificate including an attacker's. The code refuses to
# connect rather than silently downgrade.
#
# Use the REGIONAL bundle, not the global one:
#
#   curl -o db/rds-ca-bundle.pem \
#     https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem
#
# The global bundle is 165KB across 108 roots. Vercel caps the total size of
# all environment variables at 64KB, so the global bundle works locally and
# then fails at deploy. The regional bundle is 4.6KB and holds the three roots
# for this region, including "Amazon RDS us-east-1 Root CA RSA2048 G1" which
# signs the rds-ca-rsa2048-g1 server certificate. Swap the region in that URL
# if the instance ever moves.
#
# Paste the file contents here, wrapped in double quotes. Multi-line quoted
# values are supported by Node's env parser and by Vercel.
DB_CA_CERT=

# AI Gateway credential, used by the provider-prefixed model string in
# app/api/search/route.ts. Required for local development. On Vercel
# deployments the Gateway call authenticates via the project's OIDC token, so
# this does not need to be set there.
AI_GATEWAY_API_KEY=
